# Copie este arquivo para .env e troque os valores pelos reais.
# O .env NÃO vai para o GitHub (está no .gitignore).

# Banco de usuários (MS1)
USERS_DB_NAME=beca_usuarios
USERS_DB_USER=troque_aqui
USERS_DB_PASSWORD=troque_aqui

# Banco de transações (MS2)
TRANSACTIONS_DB_NAME=beca_transacoes
TRANSACTIONS_DB_USER=troque_aqui
TRANSACTIONS_DB_PASSWORD=troque_aqui

# APIs externas
MOCKAPI_BASE_URL=https://xxxx.mockapi.io/api/v1
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Segurança: chave aleatória com pelo menos 32 caracteres
JWT_SECRET=troque_aqui

# Endereço do MS1 (usado pelo MS2)
MS1_URL=http://localhost:8081
