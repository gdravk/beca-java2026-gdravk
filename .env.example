# arquivo de exemplo mostra as variaveis do .env (valores reais)
# o .env esta no .gitignore

# Banco de usuários (MS1)
USERS_DB_NAME=nome_do_banco
USERS_DB_USER=usuario_do_banco
USERS_DB_PASSWORD=senha_do_usuario_do_banco

# Banco de transações (MS2)
TRANSACTIONS_DB_NAME=nome_do_banco_de_transacoes
TRANSACTIONS_DB_USER=usuario_do_banco_de_transacoes
TRANSACTIONS_DB_PASSWORD=senha_do_usuario_do_banco_de_transacoes

# APIs externas
MOCKAPI_BASE_URL=https://xxxx.mockapi.io
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Segurança: chave aleatória com pelo menos 32 caracteres
JWT_SECRET=troque_aqui

# Endereço do MS1 (usado pelo MS2)
MS1_URL=http://localhost:8081

# Chave interna entre MS1 e MS2 (protege o POST /auth/verificar): o mesmo valor nos dois servicos
# gere uma chave aleatoria com pelo menos 16 caracteres
MS1_CHAVE_INTERNA=troque_por_uma_chave_aleatoria
